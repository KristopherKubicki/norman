{
  "schema": "norman.codex-bridge-parity-cases.v1",
  "cases": [
    {
      "id": "cp-agent-action-boundaries",
      "title": "Control Plane agent action boundaries",
      "category": "policy",
      "requires_repository_tools": true,
      "prompt": "Read README.md and docs/agent_action_policy.md. Explain the default action stance, name two actions that require human approval, and identify the boundary between Data Operations work and developer-controlled work. Cite the repository paths that support each claim.",
      "required_facts": [
        {
          "id": "default-dry-run",
          "all_terms": ["dry-run", "default"],
          "weight": 1.0
        },
        {
          "id": "human-approval-boundary",
          "any_terms": ["human approval", "explicit signoff", "not allowed"],
          "weight": 1.0
        },
        {
          "id": "developer-control",
          "all_terms": ["developer", "controlled"],
          "weight": 1.0
        }
      ],
      "required_evidence": [
        {
          "id": "policy-path",
          "all_terms": ["docs/agent_action_policy.md"],
          "weight": 1.0
        },
        {
          "id": "readme-path",
          "all_terms": ["README.md"],
          "weight": 0.5
        }
      ],
      "wisdom_checks": [
        {
          "id": "no-overclaim",
          "any_terms": ["require", "approval", "controlled"],
          "weight": 0.5
        }
      ],
      "known_traps": [
        {
          "id": "claim-unrestricted-writes",
          "all_terms": ["unrestricted", "production writes"],
          "weight": 1.0
        }
      ],
      "answer_contract": {
        "min_response_words": 90,
        "min_sentences": 4,
        "required_sections": ["Evidence", "Boundary"],
        "requires_caveat": true,
        "min_reasoning_markers": 1
      }
    },
    {
      "id": "cp-public-surface-gate",
      "title": "Control Plane public-surface closure gate",
      "category": "policy",
      "requires_repository_tools": true,
      "prompt": "Read docs/agent_action_policy.md and identify the required gate before closing work that changes a customer-visible or executive-visible surface. Explain why a dry-run alone is insufficient, and state what verification must be retained. Cite the relevant path.",
      "required_facts": [
        {
          "id": "required-flag",
          "all_terms": ["public_surface_check.required=true"],
          "weight": 1.0
        },
        {
          "id": "explicit-verification",
          "all_terms": ["verify", "surface"],
          "weight": 1.0
        },
        {
          "id": "dry-run-insufficient",
          "all_terms": ["dry-run", "alone"],
          "weight": 1.0
        }
      ],
      "required_evidence": [
        {
          "id": "policy-path",
          "all_terms": ["docs/agent_action_policy.md"],
          "weight": 1.0
        }
      ],
      "wisdom_checks": [
        {
          "id": "closure-caveat",
          "any_terms": ["before closure", "do not", "must"],
          "weight": 0.5
        }
      ],
      "known_traps": [
        {
          "id": "dry-run-is-enough",
          "all_terms": ["dry-run", "sufficient"],
          "weight": 1.0
        }
      ],
      "answer_contract": {
        "min_response_words": 65,
        "min_sentences": 3,
        "required_sections": ["Evidence", "Decision"],
        "requires_caveat": true,
        "min_reasoning_markers": 1
      }
    },
    {
      "id": "cp-runbook-runner-mutation-gates",
      "title": "Runbook runner mutation gates",
      "category": "runbook",
      "requires_repository_tools": true,
      "prompt": "Inspect scripts/runbook_runner.py. Compare the safety gates for a Jira comment and a live GAPI submit. State the default behavior, every flag required for a live GAPI submit, and the audit behavior. Cite the source path and avoid proposing any execution.",
      "required_facts": [
        {
          "id": "jira-default",
          "all_terms": ["jira", "dry-run"],
          "weight": 1.0
        },
        {
          "id": "gapi-live-flags",
          "all_terms": ["--live", "--apply", "--confirm-live"],
          "weight": 1.0
        },
        {
          "id": "audit-event",
          "all_terms": ["audit", "write"],
          "weight": 1.0
        }
      ],
      "required_evidence": [
        {
          "id": "runner-path",
          "all_terms": ["scripts/runbook_runner.py"],
          "weight": 1.0
        }
      ],
      "wisdom_checks": [
        {
          "id": "no-execution",
          "any_terms": ["do not execute", "no execution", "read-only", "do not run"],
          "weight": 0.5
        }
      ],
      "known_traps": [
        {
          "id": "apply-alone-is-live",
          "all_terms": ["--apply", "alone"],
          "weight": 1.0
        }
      ],
      "answer_contract": {
        "min_response_words": 90,
        "min_sentences": 4,
        "required_sections": ["Evidence", "Comparison"],
        "requires_caveat": true,
        "requires_comparison": true,
        "min_reasoning_markers": 1
      }
    },
    {
