  "issued_at": "2026-08-09T00:00:00Z",
  "default_policy": "GPT-5.6 Terra is the only active Codex model for work and personal sessions",
  "roles": {
    "work_standard": {
      "provider": "aws-bedrock",
      "profile_v2": "traqline-bedrock",
      "aws_profile": "ob-traqline-admin",
      "aws_region": "us-east-2",
      "model": "openai.gpt-5.6-terra",
      "service_tier": "default",
      "allowed_use": "normal work Codex route; Bedrock GPT-5.6 Terra is the fleet baseline",
      "production_default": true
    },
    "work_direct": {
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "service_tier": "default",
      "allowed_use": "direct GPT-5.6 Terra route when Bedrock transport is unavailable",
      "production_default": true
    },
    "work_final_authority": {
      "provider": "aws-bedrock",
      "profile_v2": "traqline-bedrock",
      "aws_profile": "ob-traqline-admin",
      "model": "openai.gpt-5.6-terra",
      "service_tier": "priority",
      "allowed_use": "priority GPT-5.6 Terra route for high-regret work and evidence gates",
      "production_default": true
    },
    "personal_default": {
      "provider": "aws-bedrock",
      "profile_v2": "personal-bedrock",
      "aws_profile_env": "NORMAN_SYNC_NON_WORK_BEDROCK_AWS_PROFILE",
      "aws_region_env": "NORMAN_SYNC_NON_WORK_BEDROCK_AWS_REGION",
      "model": "openai.gpt-5.6-terra",
      "service_tier": "default",
      "allowed_use": "normal personal Codex route; Bedrock GPT-5.6 Terra is the validated baseline",
      "production_default": true
    },
    "personal_direct": {
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "service_tier": "default",
      "allowed_use": "direct GPT-5.6 Terra route when personal Bedrock transport is unavailable",
      "production_default": true
    },
    "personal_final_authority": {
      "provider": "aws-bedrock",
      "profile_v2": "personal-bedrock",
      "aws_profile_env": "NORMAN_SYNC_NON_WORK_BEDROCK_AWS_PROFILE",
      "aws_region_env": "NORMAN_SYNC_NON_WORK_BEDROCK_AWS_REGION",
      "model": "openai.gpt-5.6-terra",
      "service_tier": "priority",
      "allowed_use": "priority GPT-5.6 Terra route for high-regret personal work",
      "production_default": true
    }
  },
  "switchable_models": {
    "work": [
      "openai.gpt-5.6-terra",
      "gpt-5.6-terra"
    ],
    "personal": [
      "openai.gpt-5.6-terra",
      "gpt-5.6-terra"
    ]
  },
  "rules": {
    "cloud_default": "gpt-5.6-terra",
    "active_codex_model": "gpt-5.6-terra",
    "cloud_is_last_resort_after_local": false,
    "promotion_source": "live_receipts_and_policy_gates",
    "no_dry_run_cutover_promotion": true,
    "tui_routing_waterfall": [
      "gpt_5_6_terra_via_bedrock",
      "gpt_5_6_terra_via_direct_compatibility_route",
      "fail_explicitly_when_terra_is_unavailable"
    ],
    "bedrock_automatic_fallback_requires_verified_subscription_exhaustion": false,
    "norllama_pool_persistence_is_generic": false
  }
