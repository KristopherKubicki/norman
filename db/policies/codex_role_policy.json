{
  "schema": "norman.codex-role-policy.v1",
  "version": "2026.07.15.role-v1",
  "policy_id": "2026.07.15.role-v1:60a03317cbb4",
  "policy_hash": "60a03317cbb478779c4fd9addb489b149965b4a1b5a3568e5a1d3c531c3e6985",
  "issued_at": "2026-07-17T18:30:00Z",
  "default_policy": "local-first, GPT-5.4 work baseline, GPT-5.6 Terra personal Bedrock baseline, GPT-5.5 work final-authority only",
  "roles": {
    "work_standard": {
      "provider": "aws-bedrock",
      "profile_v2": "traqline-bedrock",
      "aws_profile": "ob-traqline-admin",
      "model": "openai.gpt-5.4",
      "service_tier": "default",
      "allowed_use": "normal work-special cloud fallback after local-first routing",
      "production_default": true
    },
    "work_direct": {
      "provider": "openai",
      "model": "openai.gpt-5.4",
      "service_tier": "default",
      "allowed_use": "direct compatibility route when Bedrock is unavailable",
      "production_default": true
    },
    "work_final_authority": {
      "provider": "aws-bedrock",
      "profile_v2": "traqline-bedrock",
      "aws_profile": "ob-traqline-admin",
      "model": "openai.gpt-5.5",
      "service_tier": "priority",
      "allowed_use": "high-regret final authority, tiebreaker, safety boundary, or failed evidence gate",
      "production_default": false
    },
    "personal_default": {
      "provider": "aws-bedrock",
      "profile_v2": "personal-bedrock",
      "aws_profile_env": "NORMAN_SYNC_NON_WORK_BEDROCK_AWS_PROFILE",
      "aws_region_env": "NORMAN_SYNC_NON_WORK_BEDROCK_AWS_REGION",
      "model": "openai.gpt-5.6-terra",
      "service_tier": "default",
      "allowed_use": "personal/non-work cloud fallback after local-first routing; Bedrock GPT-5.6 Terra is the validated personal baseline",
      "production_default": true
    },
    "personal_direct": {
      "provider": "openai",
      "model": "gpt-5.4",
      "service_tier": "default",
      "allowed_use": "direct compatibility route when personal Bedrock is unavailable or disabled",
      "production_default": true
    },
    "personal_final_authority": {
      "provider": "aws-bedrock",
      "profile_v2": "personal-bedrock",
      "aws_profile_env": "NORMAN_SYNC_NON_WORK_BEDROCK_AWS_PROFILE",
      "aws_region_env": "NORMAN_SYNC_NON_WORK_BEDROCK_AWS_REGION",
      "model": "openai.gpt-5.6-sol",
      "service_tier": "priority",
      "allowed_use": "personal high-regret final authority only; Sol is reserved for difficult or high-regret work",
      "production_default": false
    }
  },
  "switchable_models": {
    "work": [
      "openai.gpt-5.4",
      "openai.gpt-5.5",
      "gpt-5.4",
      "gpt-5.5"
    ],
    "personal": [
      "openai.gpt-5.4",
      "openai.gpt-5.5",
      "openai.gpt-5.6-luna",
      "openai.gpt-5.6-terra",
      "openai.gpt-5.6-sol",
      "gpt-5.4",
      "gpt-5.5",
      "gpt-5.6-luna",
      "gpt-5.6-terra",
      "gpt-5.6-sol"
    ]
  },
  "rules": {
    "cloud_default": "gpt-5.4",
    "gpt_5_5_scope": "final_authority_only",
    "cloud_is_last_resort_after_local": true,
    "promotion_source": "live_receipts_and_policy_gates",
    "no_dry_run_cutover_promotion": true
  }
}
