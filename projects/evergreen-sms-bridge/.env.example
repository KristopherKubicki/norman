AWS_PROFILE=example-profile
AWS_REGION=us-east-2
INBOUND_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/<account-id>/evergreen-sms-inbound
COMPLETION_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/<account-id>/evergreen-sms-completion
SMS_CONVERSATIONS_TABLE=evergreen-sms-conversations

# The correlated production path. Legacy spool/webhook/collector/tmux modes
# remain available only when explicitly selected during migration.
DELIVERY_MODE=sms
BBS_URL=http://127.0.0.1:8798
BBS_TOKEN=
SMS_CALLBACK_BIND=127.0.0.1
SMS_CALLBACK_PORT=8797
SMS_CALLBACK_URL=http://127.0.0.1:8797/callbacks/sms
# Set the token through systemd's CREDENTIALS_DIRECTORY in production.
# SMS_CALLBACK_TOKEN_FILE is for a temporary encrypted-credential migration.
SMS_CALLBACK_TOKEN_FILE=
SMS_BRIDGE_STATE_DIR=~/.local/state/cloudagent/evergreen-sms
BBS_REQUEST_TIMEOUT_SEC=20
OUTBOX_RETRY_SECONDS=5

# Legacy migration settings:
KEEP_SPOOL_COPY=true
SPOOL_DIR=~/.local/state/cloudagent/evergreen-sms/inbox
WEBHOOK_URL=http://127.0.0.1:8796/hooks/evergreen-sms
WEBHOOK_TIMEOUT_SEC=10

COLLECTOR_URL=http://127.0.0.1:8796
COLLECTOR_TOKEN=
COLLECTOR_TIMEOUT_SEC=10

TMUX_TARGET=norman-bot-prime:0.0
TMUX_SOCKET_PATH=
TMUX_WORKING_DIR=/home/operator/code/norman
TMUX_SEND_ENTER=true
TMUX_ENTER_COUNT=2

POLL_WAIT_TIME_SEC=20
VISIBILITY_TIMEOUT_SEC=180
MAX_NUMBER_OF_MESSAGES=5
RUN_ONCE=false
