[Unit]
Description=Evergreen SMS bridge consumer
After=network-online.target norman-sms-bbs.service
Wants=network-online.target norman-sms-bbs.service

[Service]
Type=simple
User=kristopher
Group=kristopher
WorkingDirectory=/home/kristopher/code/norman/projects/evergreen-sms-bridge
EnvironmentFile=-/etc/norman/evergreen-sms-bridge.env
Environment=PYTHONUNBUFFERED=1
Environment=DELIVERY_MODE=sms
Environment=BBS_URL=http://127.0.0.1:8798
Environment=SMS_CALLBACK_BIND=127.0.0.1
Environment=SMS_CALLBACK_PORT=8797
Environment=SMS_BRIDGE_STATE_DIR=/var/lib/evergreen-sms-bridge
LoadCredentialEncrypted=sms-callback-token:/etc/norman/credentials/sms-callback-token.cred
StateDirectory=evergreen-sms-bridge
StateDirectoryMode=0700
ExecStart=/home/kristopher/code/norman/projects/evergreen-sms-bridge/.venv/bin/python /home/kristopher/code/norman/projects/evergreen-sms-bridge/sms_bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
