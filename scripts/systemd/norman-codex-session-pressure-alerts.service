[Unit]
Description=Post Norman Codex session pressure alerts to Switchboard BBS
After=network-online.target switchboard-bbs.service
Wants=network-online.target switchboard-bbs.service
ConditionPathExists=/etc/norman/tui-fleet-alerts.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
StateDirectory=norman
WorkingDirectory=/home/kristopher/code/norman
EnvironmentFile=/etc/norman/tui-fleet-alerts.env
ExecStart=/usr/bin/python3 /home/kristopher/code/norman/scripts/tui_fleet_alerts.py --health-json /home/kristopher/.local/state/norman/codex-session-pressure.json --state /var/lib/norman/codex-session-pressure-alerts-state.json --thread-id th_codex_session_pressure "--title=Norman Codex session pressure" --warn-threshold 1 --report-path /home/kristopher/.local/state/norman/codex-session-pressure.json
