[Unit]
Description=Sync local Norman agent console template writes

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/kristopher/code/norman
RuntimeDirectory=norman-agent-console-sync
RuntimeDirectoryMode=0750
Environment=PYTHONPATH=/home/kristopher/code/norman
Environment=NORMAN_SYNC_EXECUTION_HOST=%H
Environment=NORMAN_SYNC_NON_WORK_BEDROCK_PROFILE_SOURCE=/home/kristopher/.codex-nonwork/personal-bedrock.config.toml
ExecStart=/usr/bin/flock -n /run/norman-agent-console-sync/sync-local.lock /home/kristopher/code/norman/.venv/bin/python /home/kristopher/code/norman/scripts/sync_agent_console_template.py --targets %H --restart-web-only
