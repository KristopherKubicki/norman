#!/usr/bin/env bash
set -euo pipefail

# Prefer Norman's checkout-aware router even when systemd's minimal PATH also
# exposes a raw global Codex binary. This keeps SMS on the governed Norman
# gateway, including its approved local-first/cloud-fallback policy.
routed_codex=${NORMAN_ROUTED_CODEX_BIN:-"${HOME}/.local/bin/codex"}
if [[ -x "${routed_codex}" ]]; then
    exec "${routed_codex}" "$@"
fi

nvm_dir=${NVM_DIR:-"${HOME}/.nvm"}
if [[ -s "${nvm_dir}/nvm.sh" ]]; then
    # nvm selects the configured default Node release, including its Codex CLI.
    # shellcheck disable=SC1090
    . "${nvm_dir}/nvm.sh"
    nvm use --silent default >/dev/null
fi

if ! command -v codex >/dev/null 2>&1; then
    printf '%s\n' "Unable to find codex after loading NVM." >&2
    exit 127
fi

exec codex "$@"
