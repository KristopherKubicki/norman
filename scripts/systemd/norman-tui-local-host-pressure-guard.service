[Unit]
Description=Norman local host pressure guard
After=local-fs.target

[Service]
Type=oneshot
User=kristopher
Group=kristopher
UMask=0077
WorkingDirectory=/home/kristopher/code/norman
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
TimeoutStartSec=10s
ExecStart=/usr/bin/python3 /home/kristopher/code/norman/scripts/tui_local_host_pressure_guard.py --apply --json-output /home/kristopher/.local/state/norman/tui-local-host-pressure-guard.json
