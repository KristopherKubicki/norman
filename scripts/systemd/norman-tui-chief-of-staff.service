[Unit]
Description=Generate Norman TUI chief-of-staff update
After=network-online.target norman-tui-fleet-doctor.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/kristopher/code/norman
EnvironmentFile=/etc/norman/tui-fleet-alerts.env
ExecStartPre=/usr/bin/mkdir -p /home/kristopher/.local/state/norman
ExecStart=/home/kristopher/code/norman/.venv/bin/python /home/kristopher/code/norman/scripts/tui_chief_of_staff.py
TimeoutStartSec=2min
