[Unit]
Description=Verify Norman TUI local planner cold-timeout recovery without inference
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kristopher
Group=kristopher
WorkingDirectory=/home/kristopher/code/norman
ExecStartPre=/usr/bin/mkdir -p /home/kristopher/.local/state/norman
ExecStart=/home/kristopher/code/norman/.venv/bin/python /home/kristopher/code/norman/scripts/tui_status_route_proof.py --cold-recovery-drill --targets uplink norman publisher platinum-standard --output-json /home/kristopher/.local/state/norman/tui-cold-recovery-drill.json --output-md /home/kristopher/.local/state/norman/tui-cold-recovery-drill.md
TimeoutStartSec=5min
