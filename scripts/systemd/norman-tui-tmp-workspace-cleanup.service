[Unit]
Description=Safely clean expired Norman agent workspaces from /tmp
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/kristopher/code/norman
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/python3 /home/kristopher/code/norman/scripts/tui_tmp_workspace_cleanup.py --apply --json-output /var/lib/norman/state/tui-tmp-workspace-cleanup.json
